          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      },
      "patch": {
        "summary": "Update person",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Person"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Email already used",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      },
      "delete": {
        "summary": "Delete person",
        "description": "Refused with PERSON_LEADS_TEAM while the person leads a team.",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Person leads a team",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/ai/status": {
      "get": {
        "summary": "Whether Claude is configured, and which model answers",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AiStatus"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/ask": {
      "post": {
        "summary": "Ask the Claude-powered assistant about teams and people",
        "description": "Claude reads teams and people through read-only tools and may return up to three views that reference record IDs. Limited to 20 questions per minute.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AiAskInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AiAnswer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "502": {
            "description": "Claude could not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "AI not configured or unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Company": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "industry",
          "website",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "industry": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "website": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "ARCHIVED"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CompanyInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "email", "industry"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "industry": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "website": {
            "type": "string",
            "maxLength": 2048,
            "description": "HTTP(S) URL or empty string to clear."
          }
        }
      },
      "CompanyUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "industry": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "website": {
            "type": "string",
            "maxLength": 2048,
            "description": "HTTP(S) URL or empty string to clear."
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "ARCHIVED"]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      },
      "PersonSummary": {
        "type": "object",
        "required": ["id", "name", "role", "workMode"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "workMode": {
            "type": "string",
            "enum": ["OFFICE", "REMOTE", "EXTERNAL"]
          }
        }
      },
      "TeamSummary": {
        "type": "object",
        "required": ["id", "name", "icon", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["LEADERSHIP", "TECHNICAL", "BUSINESS", "EXTERNAL"]
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role",
          "location",
          "timezone",
          "workMode",
          "kind",
          "teams",
          "leadsTeamIds",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "workMode": {
            "type": "string",
            "enum": ["OFFICE", "REMOTE", "EXTERNAL"]
          },
          "kind": {
            "type": "string",
            "enum": ["STAFF", "EXTERNAL"]
          },
          "teams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamSummary"
            }
          },
          "leadsTeamIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PersonInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "role",
          "location",
          "timezone",
          "teamIds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "role": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "timezone": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "workMode": {
            "type": "string",
            "enum": ["OFFICE", "REMOTE", "EXTERNAL"],
            "default": "OFFICE"
          },
          "teamIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 20
          }
        }
      },
      "PersonUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "workMode": {
            "type": "string",
            "enum": ["OFFICE", "REMOTE", "EXTERNAL"]
          }
        }
      },
      "Team": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "kind",
          "icon",
          "leadId",
          "isCore",
          "lead",
          "memberCount",
          "members",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "purpose": {
            "type": "string",
            "maxLength": 240
          },
          "kind": {
            "type": "string",
            "enum": ["LEADERSHIP", "TECHNICAL", "BUSINESS", "EXTERNAL"]
          },
          "icon": {
            "type": "string",
            "enum": [
              "users",
              "briefcase",
              "code",
              "sparkles",
              "megaphone",
              "trending",
              "server",
              "shield"
            ]
          },
          "leadId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "lead": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PersonSummary"
              }
            ],
            "nullable": true
          },
          "isCore": {
            "type": "boolean",
            "description": "Core company team (seeded). Only an executive can edit or delete it."
          },
          "memberCount": {
            "type": "integer"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonSummary"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TeamInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose", "leadId"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "purpose": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240
          },
          "kind": {
            "type": "string",
            "enum": ["LEADERSHIP", "TECHNICAL", "BUSINESS", "EXTERNAL"],
            "default": "TECHNICAL"
          },
          "icon": {
            "type": "string",
            "enum": [
              "users",
              "briefcase",
              "code",
              "sparkles",
              "megaphone",
              "trending",
              "server",
              "shield"
            ],
            "default": "users"
          },
          "leadId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TeamUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "leadId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AiView": {
        "type": "object",
        "required": ["kind", "title"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["teams_overview", "team", "people"]
          },
          "title": {
            "type": "string"
          },
          "teamId": {
            "type": "string",
            "format": "uuid"
          },
          "personIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "AiAskInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2000
          },
          "history": {
            "type": "array",
            "maxItems": 12,
            "description": "Earlier turns, oldest first, alternating user then assistant",
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["user", "assistant"]
                },
                "content": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            }
          }
        }
      },
      "AiAnswer": {
        "type": "object",
        "required": ["answer", "views", "model", "stopReason"],
        "properties": {
          "answer": {
            "type": "string"
          },
          "views": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiView"
            }
          },
          "model": {
            "type": "string"
          },
          "stopReason": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AiStatus": {
        "type": "object",
        "required": ["configured", "model"],
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "model": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "PreviewRole": {
        "name": "X-Preview-Role",
        "in": "header",
        "required": false,
        "description": "Demo-only preview role from the frontend role switcher; not authentication. Missing or unknown values are treated as developer (read-only).",
        "schema": {
          "type": "string",
          "enum": ["executive", "manager", "developer"]
        }
      }
    }
  }
}
